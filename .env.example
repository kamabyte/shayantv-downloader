# Copy to .env next to compose.yml (or paste into the stack's Environment tab).

# Host directories. Both must exist: the container won't create them.
DATA_PATH=/srv/shayantv/data
MEDIA_PATH=/srv/media/Shayan TV

# User and group that own DATA_PATH and MEDIA_PATH.
PUID=1000
PGID=1000

TZ=Europe/Moscow

# Image tag: latest, or sha-<commit> to pin/roll back.
IMAGE_TAG=latest

# Hours between syncs.
INTERVAL_HOURS=12

# Parallel episode downloads.
CONCURRENCY=2

# Optional: Jellyfin → Dashboard → API Keys. Triggers a library scan after new episodes.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
